---
import { Image } from 'astro:assets';
import Layout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
const {title,description,pubDate,updatedDate,heroImage,category='Sống & nghĩ',sample=false}=Astro.props;
---
<Layout title={`${title} | Tùng.`} description={description} image={heroImage}>
<article class="reading-page"><a class="textlink back-link" href="/blog/">← Tất cả bài viết</a><div class="meta"><span class="tag">{category}</span><span class="sep"></span><FormattedDate date={pubDate}/></div><h1>{title}</h1><p class="description">{description}</p>{sample && <p class="sample-note">Bài viết minh họa cho giao diện, chưa phải nội dung chính thức của tác giả.</p>}{updatedDate && <p class="date">Cập nhật <FormattedDate date={updatedDate}/></p>}{heroImage && <Image class="reading-hero" src={heroImage} alt="" width={1020} height={510}/>}<div class="prose"><slot/></div><a class="textlink" href="/blog/">Đọc thêm những ghi chép khác →</a></article>
</Layout>
