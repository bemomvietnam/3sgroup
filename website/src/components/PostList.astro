---
import FormattedDate from './FormattedDate.astro';
const { posts }=Astro.props;
const categories=['Công việc','Công nghệ','Sống & nghĩ'];
const keys=['cong-viec','cong-nghe','song'];
const thumbs=["<svg viewBox=\"0 0 116 116\"><rect width=\"116\" height=\"116\" fill=\"#dce5d4\"/><rect x=\"28\" y=\"20\" width=\"61\" height=\"78\" rx=\"3\" fill=\"#faf7e8\"/><path d=\"M42 40h31M42 53h31M42 66h22M42 79h27\" stroke=\"#9ba98a\" stroke-width=\"3\"/><path d=\"m76 18 6 2-19 55-7 6-1-9Z\" fill=\"#c57750\"/></svg>", "<svg viewBox=\"0 0 116 116\"><rect width=\"116\" height=\"116\" fill=\"#e2dfef\"/><rect x=\"22\" y=\"30\" width=\"72\" height=\"50\" rx=\"7\" fill=\"#807d9d\"/><rect x=\"28\" y=\"36\" width=\"60\" height=\"38\" rx=\"3\" fill=\"#f5f2fa\"/><path d=\"M17 87h82\" stroke=\"#807d9d\" stroke-width=\"6\"/><path d=\"m58 43 4 10 11 4-11 4-4 10-4-10-11-4 11-4Z\" fill=\"#c4aa70\"/></svg>", "<svg viewBox=\"0 0 116 116\"><rect width=\"116\" height=\"116\" fill=\"#ecdcc9\"/><ellipse cx=\"56\" cy=\"88\" rx=\"34\" ry=\"6\" fill=\"#cdb99e\"/><path d=\"M32 43h45v30c0 13-45 13-45 0Z\" fill=\"#fcf3e1\"/><path d=\"M77 49h7c16 0 14 24-7 24\" fill=\"none\" stroke=\"#fcf3e1\" stroke-width=\"7\"/><ellipse cx=\"54\" cy=\"43\" rx=\"22\" ry=\"5\" fill=\"#9c7353\"/><path d=\"M47 30c-8-9 8-9 1-18m15 18c-8-9 8-9 1-18\" fill=\"none\" stroke=\"#b69c81\" stroke-width=\"2\"/></svg>", "<svg viewBox=\"0 0 116 116\"><rect width=\"116\" height=\"116\" fill=\"#d8e3e0\"/><path d=\"M24 29h69v47H59L40 91V76H24Z\" fill=\"#f6f5e7\"/><path d=\"M48 45c0-14 26-14 26 0 0 9-13 8-13 17\" stroke=\"#5d8277\" stroke-width=\"5\" fill=\"none\"/><circle cx=\"61\" cy=\"70\" r=\"2.5\" fill=\"#5d8277\"/></svg>"];
---
<div class="section-heading"><h2>Những ghi chép gần đây</h2><span class="count" id="post-count">{String(posts.length).padStart(2,'0')}</span></div>
<div class="filters" aria-label="Lọc bài theo chủ đề"><button class="filter" data-filter="all" aria-pressed="true">Tất cả</button>{categories.map((c,i)=><button class="filter" data-filter={keys[i]} aria-pressed="false">{c}</button>)}</div>
<div id="posts">{posts.map((post,i)=><article class="post" data-category={keys[categories.indexOf(post.data.category)]}>
<div><div class="meta"><span class="tag">{post.data.category}</span><span class="sep"></span><span>{Math.max(1,Math.ceil((post.body || '').split(/\s+/).length/200))} phút đọc</span></div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><span class="date"><FormattedDate date={post.data.pubDate}/></span></div>
<div class="thumb" aria-hidden="true" set:html={thumbs[i%thumbs.length]}/></article>)}</div>
<p class="no-results" id="no-results" hidden>Chưa có bài viết trong chủ đề này.</p>
